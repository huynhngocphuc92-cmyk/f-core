    "@prisma/client": "^7.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.0",
    "@types/pg": "^8.16.0",
    "ai": "^6.0.79",
    "class-variance-authority": "^0.7.1",
