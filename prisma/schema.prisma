model Ticket {
  id            String    @id @default(uuid())
  tenantId      String
  ticketNumber  Int       @default(autoincrement())

  // Content
  subject       String
  description   String?   @db.Text
  category      String?   // bug, feature, question, support

  // Status & Priority
  status        String    @default("open") // open, in_progress, waiting, resolved, closed
  priority      String    @default("medium") // low, medium, high, urgent

  // Assignments
  assigneeId    String?
  createdById   String?
  contactId     String?
  companyId     String?

  // SLA
  dueDate       DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  firstResponseAt DateTime?

  // Metadata
  tags          Json?     // string array
  source        String?   // email, phone, web, chat

