  completedAt DateTime?
  steps       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

model WorkflowVersionSnapshot {
  id         String    @id @default(uuid())
  tenantId   String
  workflowId String
  version    Int
  label      String
  snapshot   Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, workflowId, version])
  @@index([tenantId])
  @@index([tenantId, workflowId])
}

model WorkflowRuntimeRun {
  id           String    @id @default(uuid())
  tenantId     String
  workflowId   String
  status       String
  maxRetries   Int
  versionId    String?
  payload      Json      @default("{}")
  attempts     Json      @default("[]")
  retriesUsed  Int       @default(0)
  deadLetterId String?
  startedAt    DateTime
  completedAt  DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workflowId])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

model WorkflowRuntimeDeadLetter {
  id          String    @id @default(uuid())
  tenantId    String
  workflowId  String
  runId       String
  reason      String
  payload     Json      @default("{}")
  attempts    Int
  latestError String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, runId])
  @@index([tenantId])
  @@index([tenantId, workflowId])
  @@index([tenantId, resolvedAt])
  @@index([tenantId, createdAt])
}

model AiPromptVersion {
  id        String    @id @default(uuid())
  tenantId  String
  agent     String
  version   Int
  label     String
  prompt    String    @db.Text
  isActive  Boolean   @default(false)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, agent, version])
  @@index([tenantId])
  @@index([tenantId, agent])
  @@index([tenantId, agent, isActive])
}

model AiOrchestrationMemory {
  id             String    @id @default(uuid())
  tenantId       String
  conversationId String
  intents        Json      @default("[]")
  facts          Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, conversationId])
  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model ServiceSlaPolicyConfig {
  id          String    @id @default(uuid())
  tenantId    String    @unique
  policy      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ServiceRoutingPolicyConfig {
  id          String    @id @default(uuid())
  tenantId    String    @unique
  policy      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ServiceOmnichannelThread {
  id              String    @id @default(uuid())
  tenantId        String
  channel         String
  externalThreadId String?
  subject         String
  status          String    @default("open")
  priority        String?
  assigneeId      String?
  contactName     String?
  contactEmail    String?
  messagePreview  String?
  metadata        Json      @default("{}")
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, channel, status])
  @@index([tenantId, updatedAt])
